vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    sketch: false
    pad: 20
  }
}

screen: "" {
  shape: rectangle
  width: 300
  height: 620
  style.stroke: "#333333"
  style.stroke-width: 3
  style.border-radius: 20
  style.fill: "#fcfcfc"

  header_bar: "" {
    shape: rectangle
    width: 300
    height: 50
    style.fill: "#f5f5f5"
    style.stroke: "#dddddd"
    style.border-radius: 17
    
    back_arrow: "←" {
      shape: text
      style.font-size: 18
    }
    
    title: "Pas Advies Aan" {
      shape: text
      style.font-size: 17
      style.bold: true
    }
  }

  body_content: "" {
    shape: rectangle
    style.fill: "#fcfcfc"
    style.stroke: none
    direction: down

    form_card: "Formulier" {
      shape: rectangle
      style.fill: "#ffffff"
      style.stroke: "#dddddd"
      style.border-radius: 8
      
      field_1: "Categorie: Literatuur ✓ 99%" {
        shape: text
        style.font-size: 12
      }
      
      field_2: "Snelheid: ( ) Snel ( ) Normaal (*) Traag" {
        shape: text
        style.font-size: 12
      }
      
      field_3: "Prijs: (*) €5.00 ( ) €3.50 ( ) €7.50" {
        shape: text
        style.font-size: 12
      }
    }

    action_bar: "🖨️ Opslaan & Afdrukken" {
      shape: rectangle
      style.fill: "#28a745"
      style.stroke: "#1e7e34"
      style.border-radius: 8
      style.font-color: "#ffffff"
      style.font-weight: bold
    }
  }
}