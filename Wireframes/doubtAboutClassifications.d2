# ---------------------------------------------------------------------------
# Wireframe "Pas Advies Aan" — versie 6
# - Kans per categorie duidelijker zichtbaar
# - Categorie compact(er), prijs krijgt meer ruimte
# ---------------------------------------------------------------------------

vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    sketch: true
    pad: 40
  }
}

classes: {

  card: {
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      stroke-width: 2
      border-radius: 8
    }
  }

  section_label: {
    shape: text
    style: {
      font-size: 11
      font-color: "#888888"
      bold: true
    }
  }

  # --- Categorie-rij: compact, met procent rechts als hoofdvisualisatie ---
  row: {
    direction: right
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      stroke-width: 2
      border-radius: 6
    }
  }
  row_ai_sel: {
    direction: right
    style: {
      fill: "#f0eaff"
      stroke: "#6d4aff"
      stroke-width: 2
      border-radius: 6
    }
  }

  dot_off: {
    shape: circle
    width: 12
    height: 12
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      stroke-width: 1.5
    }
  }
  dot_on: {
    shape: circle
    width: 12
    height: 12
    style: {
      fill: "#6d4aff"
      stroke: "#6d4aff"
      stroke-width: 1.5
    }
  }

  name: {
    shape: text
    style: {
      font-size: 13
      font-color: "#333333"
    }
  }
  name_sel: {
    shape: text
    style: {
      font-size: 13
      font-color: "#333333"
      bold: true
    }
  }

  ai_tag: {
    shape: text
    style: {
      font-size: 8
      font-color: "#6d4aff"
    }
  }

  pct_large: {
    shape: text
    style: {
      font-size: 15
      font-color: "#6d4aff"
      bold: true
    }
  }
  pct_muted: {
    shape: text
    style: {
      font-size: 12
      font-color: "#999999"
    }
  }

  bar_bg: {
    shape: rectangle
    width: 60
    height: 4
    style: {
      fill: "#e0e0e0"
      stroke-width: 0
      border-radius: 2
    }
  }
  bar_fill: {
    shape: rectangle
    height: 4
    style: {
      fill: "#6d4aff"
      stroke-width: 0
      border-radius: 2
    }
  }

  chip: {
    shape: rectangle
    width: 78
    height: 48
    style: {
      fill: "#ffffff"
      stroke: "#333333"
      stroke-width: 2
      border-radius: 6
      font-size: 13
      font-color: "#333333"
    }
  }
  chip_ai: {
    shape: rectangle
    width: 78
    height: 48
    style: {
      fill: "#f0eaff"
      stroke: "#6d4aff"
      stroke-width: 2
      border-radius: 6
      font-size: 13
      font-color: "#6d4aff"
      bold: true
    }
  }

  hint: {
    shape: text
    style: {
      font-size: 12
      font-color: "#777777"
    }
  }
  muted: {
    shape: text
    style: {
      font-size: 10
      font-color: "#aaaaaa"
    }
  }
}

screen: "" {
  shape: rectangle
  width: 360
  height: 720
  style: {
    fill: "#fcfcfc"
    stroke: "#333333"
    stroke-width: 3
    border-radius: 26
  }

  header_bar: "" {
    direction: right
    style: {
      fill: "#f5f5f5"
      stroke: "#333333"
      stroke-width: 2
      border-radius: 22
    }

    back: "←" {
      shape: text
      style: { font-size: 19; font-color: "#333333" }
    }
    title: "Pas Advies Aan" {
      shape: text
      style: { font-size: 17; font-color: "#333333"; bold: true }
    }
  }

  body: "" {
    direction: down
    style: {
      fill: transparent
      stroke: transparent
    }

    ai_hint: "✦ AI-vóórkeuren:" { class: hint }

    # --- Categorie: compact, percentage DUIDELIJKER ---
    card_categorie: "" {
      class: card
      width: 320
      direction: down

      lbl_cat: "CATEGORIE" { class: section_label }

      # Regel per categorie:
      #   linksonder: naam
      #   rechts: percentage als grote tekst + balk
      r_lit: "" {
        class: row_ai_sel
        width: 300
        height: 44
        n: "Literatuur" { class: name_sel }
        pct: "99%" { class: pct_large }
        b: "" { class: bar_fill; width: 60 }
        t: "AI" { class: ai_tag }
      }

      r_rom: "" {
        class: row
        width: 300
        height: 44
        n: "Roman" { class: name }
        pct: "62%" { class: pct_muted }
        b: "" { class: bar_bg; width: 40 }
      }

      r_thr: "" {
        class: row
        width: 300
        height: 44
        n: "Thriller" { class: name }
        pct: "48%" { class: pct_muted }
        b: "" { class: bar_bg; width: 32 }
      }

      r_non: "" {
        class: row
        width: 300
        height: 44
        n: "Non-fictie" { class: name }
        pct: "31%" { class: pct_muted }
        b: "" { class: bar_bg; width: 20 }
      }

      r_kid: "" {
        class: row
        width: 300
        height: 44
        n: "Kinderboek" { class: name }
        pct: "12%" { class: pct_muted }
        b: "" { class: bar_bg; width: 8 }
      }
    }

    # --- PRIJS: nu prominenter, groter grid, meer ruimte ---
    card_prijs: "" {
      class: card
      width: 320
      direction: down

      lbl_prijs: "PRIJS" { class: section_label }

      price_grid: "" {
        grid-columns: 3
        grid-gap: 8
        style: {
          fill: transparent
          stroke: transparent
        }
        height: 260

        c050: "€0,50" { class: chip }
        c100: "€1,00" { class: chip }
        c150: "€1,50" { class: chip }

        c200: "€2,00" { class: chip }
        c250: "€2,50" { class: chip_ai }
        c300: "€3,00" { class: chip }

        c350: "€3,50" { class: chip }
        c400: "€4,00" { class: chip }
        c450: "€4,50" { class: chip }

        c500: "€5,00" { class: chip }
        c550: "€5,50" { class: chip }
        c600: "€6,00" { class: chip }

        more: "↓ meer" { class: muted }
      }
    }

    action_button: "🖨️  Opslaan & Afdrukken" {
      shape: rectangle
      width: 332
      height: 50
      style: {
        fill: "#28a745"
        stroke: "#1e7e34"
        stroke-width: 2
        border-radius: 8
        font-size: 15
        font-color: "#ffffff"
        bold: true
      }
    }

    legend: "✦ = AI-vóórkeur" { class: muted }
  }
}
